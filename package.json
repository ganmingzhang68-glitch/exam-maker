{
  "name": "exam-maker",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w shared && npm run build -w server && npm run build -w client",
    "test": "npm run test -w server",
    "lint": "eslint client/src server/src server/test shared --max-warnings=0",
    "db:generate": "npm run db:generate -w server",
    "db:migrate": "npm run db:migrate -w server",
    "db:seed": "npm run db:seed -w server",
    "questions:import-generated": "npm run questions:import-generated -w server"
  },
  "devDependencies": {
    "@types/sql.js": "^1.4.11",
    "concurrently": "^8.2.2",
    "eslint": "^9.39.5",
    "typescript-eslint": "^8.65.0"
  }
}
