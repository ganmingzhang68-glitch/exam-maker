{
  "name": "@exam-maker/server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run build -w @exam-maker/shared",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "pretest": "npm run build -w @exam-maker/shared",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/runMigrations.ts",
    "db:seed": "tsx src/seed.ts",
    "questions:import-generated": "tsx src/scripts/importGeneratedQuestions.ts"
    ,"question-generation:e2e": "tsx src/scripts/runQuestionGenerationE2E.ts",
    "load-test:phase11": "tsx src/scripts/runPhase11LoadTest.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@exam-maker/shared": "*",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.33.0",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^2.4.5",
    "sql.js": "^1.10.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
