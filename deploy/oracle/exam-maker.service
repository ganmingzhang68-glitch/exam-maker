[Unit]
Description=Exam Maker API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__APP_USER__
Group=__APP_USER__
WorkingDirectory=__APP_ROOT__/server
EnvironmentFile=__APP_ROOT__/.env
Environment=HOME=/var/lib/__APP_USER__
ExecStartPre=/usr/bin/test -f __APP_ROOT__/server/dist/index.js
ExecStart=/usr/bin/node __APP_ROOT__/server/dist/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
KillSignal=SIGTERM
UMask=0027
LimitNOFILE=65536

# The application and operating system are read-only; only runtime data and
# the service user's state directory remain writable.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=__APP_ROOT__/server/data /var/lib/__APP_USER__

[Install]
WantedBy=multi-user.target
