# Copy to /opt/exam-maker/.env on the server and run: chmod 600 /opt/exam-maker/.env
NODE_ENV=production
HOST=127.0.0.1
PORT=3001
TRUST_PROXY=1
CORS_ORIGIN=https://exam.example.com

# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# DeepSeek-compatible API configuration. Never commit the real key.
AI_API_KEY=replace-with-your-deepseek-api-key
AI_PROVIDER=deepseek
AI_MODEL=deepseek-v4-pro
AI_BASE_URL=https://api.deepseek.com
AI_MAX_TOKENS=4096
AI_CONTEXT_TOKENS=16384
AI_TIMEOUT_MS=180000

# Keep all mutable artifacts under the persistent application data directory.
EXPORT_STORAGE_DIR=/opt/exam-maker/server/data/exports

# Explicit tool locations make systemd environment detection deterministic.
PANDOC_EXECUTABLE=/usr/bin/pandoc
SOFFICE_EXECUTABLE=/usr/bin/soffice
PYTHON_EXECUTABLE=/usr/bin/python3
LATEX_EXECUTABLE=/usr/bin/xelatex
